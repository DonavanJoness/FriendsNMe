# Copy this file to .env for local testing.
# Never commit real SMTP passwords or production secrets.

SESSION_SECRET=replace-with-a-long-random-secret

# Local development uses SQLite unless DATABASE_URL or
# FRIENDSNME_DATABASE_URI is set.
# FRIENDSNME_DATABASE_URI=sqlite:///server/data/friendsnme.db

# Set this to true when you want local verification codes to be
# emailed instead of printed in the terminal.
FRIENDSNME_REQUIRE_EMAIL_DELIVERY=true

# Leave these off when you want local terminal codes.
# AUTH_LOG_VERIFICATION_CODES=true
# FRIENDSNME_DEBUG=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=FriendsNMe <no-reply@example.com>
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
SMTP_SECURE=false
