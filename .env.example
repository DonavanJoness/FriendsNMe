# Required in production. Use a long random value, at least 32 characters.
SESSION_SECRET=

# Optional. Defaults to 3000.
PORT=3000

# SMTP delivery for verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FriendsNMe <no-reply@example.com>"

# Local development only. When true outside production, verification codes are
# printed to the server console instead of being emailed.
AUTH_LOG_VERIFICATION_CODES=false
