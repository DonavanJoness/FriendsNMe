# Copy this file to .env for local testing.
# Never commit real API keys or production secrets.

SESSION_SECRET=replace-with-a-long-random-secret

# Local development uses SQLite unless DATABASE_URL or
# FRIENDSNME_DATABASE_URI is set.
# FRIENDSNME_DATABASE_URI=sqlite:///server/data/friendsnme.db

# Set this in local development if you want verification codes
# printed in the terminal instead of sent through Resend.
# AUTH_LOG_VERIFICATION_CODES=true
# FRIENDSNME_DEBUG=true

# Resend email delivery.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=FriendsNMe <no-reply@example.com>
